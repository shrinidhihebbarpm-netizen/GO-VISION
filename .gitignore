# Dependencies
node_modules/
build/
coverage/

# Production web build (kept for standalone Python server serving without requiring Node.js)
# If you rebuild with npm run build, dist/ will update
!dist/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Environment and sensitive keys
.env
.env.local
.env.*.local
!.env.example

# IDE & Editor files
.vscode/
.idea/
.antigravity/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System files
.DS_Store
Thumbs.db
